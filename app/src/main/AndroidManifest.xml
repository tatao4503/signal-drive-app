<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="SIGNAL Drive" android:theme="@style/AppTheme"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:allowBackup="false"
        android:usesCleartextTraffic="false" android:supportsRtl="true">
        <uses-library android:name="android.car" android:required="false" />
        <!-- 주행 중 사용 선언(distraction optimized). 주행·미확인 상태에서는 앱이 스스로
             주행 화면(신호·남은 시간·이유 한 줄)으로 줄이고 시연·설정 입력을 잠근다.
             Pleos·실차 심사는 받지 않았다. -->
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
