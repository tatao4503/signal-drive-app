{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-drive:trust-fixtures:v1",
  "title": "Synthetic trust acceptance cases",
  "type": "object",
  "required": ["schemaVersion", "purpose", "nowEpochMs", "policy", "approvedMappings", "baseTarget", "baseObservation", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "purpose": {"type": "string"},
    "nowEpochMs": {"type": "integer", "minimum": 1},
    "policy": {"type": "object", "required": ["maxSourceAgeMs", "maxFutureSkewMs", "maxRemainingDeciseconds"], "properties": {"maxSourceAgeMs": {"type": "integer", "minimum": 1}, "maxFutureSkewMs": {"type": "integer", "minimum": 0}, "maxRemainingDeciseconds": {"type": "integer", "minimum": 1}}},
    "approvedMappings": {"type": "array", "items": {"type": "object", "required": ["id", "version", "intersectionId", "approach", "movement", "verification", "evidenceReference"]}},
    "baseTarget": {"$ref": "#/$defs/target"},
    "baseObservation": {"$ref": "#/$defs/observation"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "expected"], "properties": {
      "id": {"type": "string", "minLength": 1}, "useEmptyRegistry": {"type": "boolean"},
      "displayMode": {"enum": ["LIVE_ONLY", "DEMONSTRATION"]},
      "targetPatch": {"type": "object"}, "observationPatch": {"type": "object"},
      "expected": {"type": "object", "required": ["kind", "reason", "phase", "remainingSeconds"], "properties": {
        "kind": {"enum": ["VERIFIED_LIVE", "DEMONSTRATION", "UNKNOWN"]}, "reason": {"type": "string"},
        "phase": {"enum": ["RED", "YELLOW", "GREEN", null]}, "remainingSeconds": {"type": ["integer", "null"], "minimum": 1}
      }}
    }}}
  },
  "$defs": {
    "approach": {"enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW", null]},
    "movement": {"enum": ["STRAIGHT", "LEFT", "UTURN", "PEDESTRIAN", "BUS", "BICYCLE", null]},
    "target": {"type": "object", "required": ["intersectionId", "approach", "movement"], "properties": {
      "intersectionId": {"type": "string"}, "approach": {"$ref": "#/$defs/approach"}, "movement": {"$ref": "#/$defs/movement"},
      "mappingId": {"type": ["string", "null"]}, "mappingVersion": {"type": ["string", "null"]}
    }},
    "observation": {"type": "object", "required": ["intersectionId", "approach", "movement", "phase", "provenance", "sourceTimestampEpochMs", "remainingDeciseconds"], "properties": {
      "intersectionId": {"type": "string"}, "approach": {"$ref": "#/$defs/approach"}, "movement": {"$ref": "#/$defs/movement"},
      "phase": {"enum": ["RED", "YELLOW", "GREEN", "UNKNOWN", "FLASHING_RED", "FLASHING_YELLOW", "DARK"]},
      "provenance": {"enum": ["LIVE", "SIMULATION", "REPLAY"]}, "sourceTimestampEpochMs": {"type": ["integer", "null"]},
      "remainingDeciseconds": {"type": ["integer", "null"]}, "mappingId": {"type": ["string", "null"]}, "mappingVersion": {"type": ["string", "null"]}
    }}
  }
}
